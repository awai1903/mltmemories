
import { getStore } from '@netlify/blobs';
import { INITIAL_MEMORIES, type MemoryItem } from '../../src/data/memories';
import {
  INITIAL_FAREWELL_NOTES,
  type FarewellNote,
} from '../../src/data/farewellNotes';
import type { Config } from '@netlify/functions';

const store = getStore({
  name: 'mltmemories-api',
  consistency: 'strong',
});

const KEYS = {
  memories: 'memories-v1',
  notes: 'farewell-notes-v1',
} as const;

const JSON_HEADERS = {
  'content-type': 'application/json; charset=utf-8',
  'cache-control': 'no-store',
};

function json(data: unknown, status = 200): Response {
  return new Response(JSON.stringify(data), {
    status,
    headers: JSON_HEADERS,
  });
}

async function readCollection<T>(
  key: string,
  initial: T,
): Promise<T> {
  const saved = (await store.get(key, {
    type: 'json',
  })) as T | null;

  if (saved !== null) return saved;

  // Initialize only if another request hasn't initialized it already.
  const result = await store.setJSON(key, initial, {
    onlyIfNew: true,
  });

  if (result.modified) return initial;

  return (await store.get(key, {
    type: 'json',
  })) as T;
}

async function readBody(
  req: Request,
): Promise<Record<string, unknown> | null> {
  const raw = await req.text();

  if (raw.length > 64_000) return null;

  try {
    const value: unknown = JSON.parse(raw);

    return value &&
      typeof value === 'object' &&
      !Array.isArray(value)
      ? (value as Record<string, unknown>)
      : null;
  } catch {
    return null;
  }
}

function cleanText(value: unknown, max: number): string {
  return typeof value === 'string'
    ? value.trim().slice(0, max)
    : '';
}

function validVisitorId(value: unknown): string {
  const id = cleanText(value, 36);

  // Accept a UUID generated by the frontend.
  const uuidPattern =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

  return uuidPattern.test(id) ? id.toLowerCase() : '';
}

/**
 * Atomically claims a Like key.
 * Only one request can create a particular key.
 */
async function claimLike(
  type: 'memory' | 'note',
  itemId: string,
  visitorId: string,
): Promise<boolean> {
  const likeKey = `like-${type}-${itemId}-${visitorId}`;

  const result = await store.set(likeKey, '1', {
    onlyIfNew: true,
  });

  return result.modified;
}

export default async (req: Request): Promise<Response> => {
  const url = new URL(req.url);
  const path = url.pathname.replace(/\/$/, '') || '/';
  const method = req.method.toUpperCase();

  try {
    // HEALTH CHECK
    if (path === '/api/health' && method === 'GET') {
      return json({
        status: 'online',
        timestamp: new Date().toISOString(),
        batch: 'MUST BS MLT BOYS (FA23 – 2027)',
        service: 'Netlify Functions API',
      });
    }

    // GET MEMORIES
    if (path === '/api/memories' && method === 'GET') {
      return json(
        await readCollection<MemoryItem[]>(
          KEYS.memories,
          INITIAL_MEMORIES,
        ),
      );
    }

    // ADD MEMORY
    if (path === '/api/memories' && method === 'POST') {
      const body = await readBody(req);

      if (!body) {
        return json(
          { error: 'Invalid JSON or request too large (64 KB max)' },
          400,
        );
      }

      const title = cleanText(body.title, 140);

      if (!title) {
        return json({ error: 'Title is required' }, 400);
      }

      const memories = await readCollection<MemoryItem[]>(
        KEYS.memories,
        INITIAL_MEMORIES,
      );

      const category = [
        'Labs & Practicals',
        'Campus Life',
        'Hostel & Nights',
        'Brotherhood',
      ].includes(String(body.category))
        ? (body.category as MemoryItem['category'])
        : 'Brotherhood';

      const newMemory: MemoryItem = {
        id: `mem-${crypto.randomUUID()}`,
        title,
        location:
          cleanText(body.location, 160) || 'MUST Campus · Mirpur',
        date:
          cleanText(body.date, 80) || 'Class of 2027 Memory',
        category,
        description: cleanText(body.description, 500),
        story: cleanText(
          body.story || body.description,
          3000,
        ),
        taggedRolls: Array.isArray(body.taggedRolls)
          ? body.taggedRolls
              .filter(
                (value): value is string =>
                  typeof value === 'string' &&
                  /^FA23-MLT-\d{3}$/.test(value),
              )
              .slice(0, 12)
          : [],
        imageUrl: cleanText(body.imageUrl, 1000) || undefined,
        likes: 0,
        isUserAdded: true,
      };

      await store.setJSON(
        KEYS.memories,
        [newMemory, ...memories].slice(0, 500),
      );

      return json(newMemory, 201);
    }

    // LIKE A MEMORY
    const memoryLike = path.match(
      /^\/api\/memories\/([^/]+)\/like$/,
    );

    if (memoryLike && method === 'POST') {
      const id = decodeURIComponent(memoryLike[1]);
      const body = await readBody(req);

      if (!body) {
        return json(
          { error: 'A valid JSON body with visitorId is required' },
          400,
        );
      }

      const visitorId = validVisitorId(body.visitorId);

      if (!visitorId) {
        return json(
          { error: 'A valid visitorId UUID is required' },
          400,
        );
      }

      const memories = await readCollection<MemoryItem[]>(
        KEYS.memories,
        INITIAL_MEMORIES,
      );

      const item = memories.find((memory) => memory.id === id);

      if (!item) {
        return json({ error: 'Memory not found' }, 404);
      }

      // Claim first. Repeated requests from this browser
      // cannot claim the same Like key again.
      const claimed = await claimLike(
        'memory',
        id,
        visitorId,
      );

      if (!claimed) {
        return json({
          id,
          likes: item.likes || 0,
          alreadyLiked: true,
        });
      }

      item.likes = (item.likes || 0) + 1;

      await store.setJSON(KEYS.memories, memories);

      return json({
        id,
        likes: item.likes,
        alreadyLiked: false,
      });
    }

    // GET FAREWELL NOTES
    if (
      path === '/api/farewell-notes' &&
      method === 'GET'
    ) {
      return json(
        await readCollection<FarewellNote[]>(
          KEYS.notes,
          INITIAL_FAREWELL_NOTES,
        ),
      );
    }

    // ADD FAREWELL NOTE
    if (
      path === '/api/farewell-notes' &&
      method === 'POST'
    ) {
      const body = await readBody(req);

      if (!body) {
        return json(
          { error: 'Invalid JSON or request too large (64 KB max)' },
          400,
        );
      }

      const authorName = cleanText(body.authorName, 80);
      const noteText = cleanText(body.note, 1500);

      if (!authorName || !noteText) {
        return json(
          { error: 'Author and note are required' },
          400,
        );
      }

      const notes = await readCollection<FarewellNote[]>(
        KEYS.notes,
        INITIAL_FAREWELL_NOTES,
      );

      const newNote: FarewellNote = {
        id: `farewell-${crypto.randomUUID()}`,
        authorName,
        authorRole:
          cleanText(body.authorRole, 100) || 'FA23 Brother',
        note: noteText,
        timestamp: new Date().toISOString(),
        likes: 0,
      };

      await store.setJSON(
        KEYS.notes,
        [newNote, ...notes].slice(0, 500),
      );

      return json(newNote, 201);
    }

    // LIKE A FAREWELL NOTE
    const noteLike = path.match(
      /^\/api\/farewell-notes\/([^/]+)\/like$/,
    );

    if (noteLike && method === 'POST') {
      const id = decodeURIComponent(noteLike[1]);
      const body = await readBody(req);

      if (!body) {
        return json(
          { error: 'A valid JSON body with visitorId is required' },
          400,
        );
      }

      const visitorId = validVisitorId(body.visitorId);

      if (!visitorId) {
        return json(
          { error: 'A valid visitorId UUID is required' },
          400,
        );
      }

      const notes = await readCollection<FarewellNote[]>(
        KEYS.notes,
        INITIAL_FAREWELL_NOTES,
      );

      const note = notes.find((entry) => entry.id === id);

      if (!note) {
        return json({ error: 'Note not found' }, 404);
      }

      const claimed = await claimLike(
        'note',
        id,
        visitorId,
      );

      if (!claimed) {
        return json({
          id,
          likes: note.likes || 0,
          alreadyLiked: true,
        });
      }

      note.likes = (note.likes || 0) + 1;

      await store.setJSON(KEYS.notes, notes);

      return json({
        id,
        likes: note.likes,
        alreadyLiked: false,
      });
    }

    return json({ error: 'Not found' }, 404);
  } catch (error) {
    console.error('MLT Memories API error:', error);

    return json(
      { error: 'Internal server error' },
      500,
    );
  }
};

export const config: Config = {
  path: [
    '/api/health',
    '/api/memories',
    '/api/memories/:id/like',
    '/api/farewell-notes',
    '/api/farewell-notes/:id/like',
  ],
};
